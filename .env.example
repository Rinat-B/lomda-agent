OPENROUTER_API_KEY=

# Model profile from agent/models.yaml: free (default) or balanced (paid models).
# A 402 (no credit) in balanced switches the session to free automatically.
PROFILE=

# Optional: the spending cap of one run in USD (default 1.5). Before a paid step that would
# cross it the agent asks [Y/N]: Y raises it for that run, N finishes with the lesson as it is.
MAX_COST_USD=

# Optional: LangSmith tracing. Off if LANGSMITH_API_KEY is empty or LANGSMITH_TRACING=false.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# LANGSMITH_ENDPOINT=   # only for non-default regions, e.g. https://eu.api.smith.langchain.com

# Hebrew display order in the terminal: on / off / auto (default; on for Windows only).
# Use "off" if your terminal already renders Hebrew right-to-left by itself.
HEBREW_BIDI=
